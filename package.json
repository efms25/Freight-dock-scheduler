{
  "name": "freight-dock-scheduler",
  "version": "1.0.0",
  "description": "Production ready Logistical dock sync manager service.",
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx watch ./src/index.ts",
    "clean": "rimraf dist",
    "build": "npm run clean && esbuild src/index.ts --bundle --platform=node --format=esm --target=node24 --packages=external --sourcemap --outfile=dist/index.js",
    "start": "node dist/index.js",
