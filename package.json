  "dependencies": {
    "@aws-sdk/client-s3": "^3.1143.0",
    "@fastify/multipart": "^10.1.2",
    "@prisma/client": "^7.10.0",
    "@prisma/orm-postgres": "^8.0.0-rc.12",
    "dotenv": "^18.0.4",
    "fastify": "^5.12.5",
    "pino": "^10.3.1"
  },
  "devDependencies": {
    "@prisma/cli-engine": "^0.6.1",
    "@tsconfig/node24": "^24.0.5",
