{
  "extends": "@tsconfig/node24/tsconfig.json",
  "compilerOptions": {
    "module": "preserve",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "rootDir": "./src",
    "outDir": "./dist",
    "noEmit": true,
    "isolatedModules": true,
    "sourceMap": false,
    "types": [
      "node"
    ],
  },
  "include": ["src"]
}