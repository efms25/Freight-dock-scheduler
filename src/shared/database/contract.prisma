// use prisma-8
 
enum ScheduleStatus {
  SCHEDULED
  OPEN
  CLOSED
  CANCELED
  DELIVERED
}

model Scheduling {
  id           Int            @id              @default(autoincrement())
  dock         String
  carrier      String
  licensePlate String
  status       ScheduleStatus @default(OPEN)
  date         DateTime
  files        String[]       @default([])
}