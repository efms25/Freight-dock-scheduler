        "description": "create table \"Scheduling\"",
        "sql": "CREATE TABLE \"public\".\"Scheduling\" (\n  \"carrier\" text NOT NULL,\n  \"date\" timestamptz NOT NULL,\n  \"dock\" text NOT NULL,\n  \"files\" text[] DEFAULT '{}' NOT NULL,\n  \"id\" SERIAL NOT NULL,\n  \"licensePlate\" text NOT NULL,\n  \"status\" text DEFAULT 'OPEN' NOT NULL,\n  PRIMARY KEY (\"id\"),\n  CONSTRAINT \"Scheduling_files_elem_not_null_ae5875f6\" CHECK (array_position(\"files\", NULL) IS NULL),\n  CONSTRAINT \"Scheduling_status_check_917782b3\" CHECK (\"status\" IN ('SCHEDULED', 'OPEN', 'CLOSED', 'CANCELED', 'DELIVERED'))\n)",
        "params": []
      }
    ],
